# Copy to .env and fill in. Vite bakes these into the build, so rebuild after changing them,
# and never put a secret here: every VITE_ value is visible in the browser.

# Backend API base URL, with the trailing slash.
VITE_API_URL=https://api.turningpages.io/api/v1/

# Google reCAPTCHA v2 (checkbox) site key for sign-up. Required: sign-up fails without it.
# Must be from the same key pair as the backend's RECAPTCHA_SECRET_KEY.
VITE_RECAPTCHA_SITE_KEY=

# CKEditor license key. Leave empty to use the free GPL license; set a commercial key if the app is not GPL.
VITE_CKEDITOR_LICENSE_KEY=

# Base URL for uploaded images (book covers). Not read by the app yet.
VITE_BOOK_IMAGE_URL=https://api.turningpages.io/images/

# Stripe publishable key (pk_live_... or pk_test_...). Not read by the app yet.
VITE_STRIPE_PUBLIC_KEY=
